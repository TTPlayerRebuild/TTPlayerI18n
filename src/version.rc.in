#include <winver.h>
1 VERSIONINFO
FILEVERSION @I18N_FIXED_VERSION@
PRODUCTVERSION @I18N_FIXED_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Sonic853\0"
      VALUE "FileDescription", "TTPlayer gettext translation add-in\0"
      VALUE "FileVersion", "@I18N_BUILD_VERSION@\0"
      VALUE "InternalName", "ttp_i18n\0"
      VALUE "OriginalFilename", "ttp_i18n.dll\0"
      VALUE "ProductName", "TTPlayer Rebuild I18N\0"
      VALUE "ProductVersion", "@I18N_BUILD_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
